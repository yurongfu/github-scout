{
  "manifest_version": 3,
  "name": "GitHub Scout — Discover & Analyze",
  "description": "Daily curated open source projects and one-click GitHub repository analysis.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": ["https://raw.githubusercontent.com/*", "https://*.workers.dev/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Open GitHub Scout"},
  "side_panel": {"default_path": "panel.html"}
}
